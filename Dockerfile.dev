# Dev image: toolchain only. Source is bind-mounted by compose.dev.yaml.
# Elixir 1.20 / OTP 29.
FROM docker.io/hexpm/elixir:1.20.4-erlang-29.1.1-debian-trixie-20260918

RUN apt-get update \
 && apt-get install -y --no-install-recommends git build-essential inotify-tools postgresql-client \
 && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

WORKDIR /app
